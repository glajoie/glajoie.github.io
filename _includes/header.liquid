<header>
  {% assign lang = page.lang | default: 'en' %}
  {% assign t = site.data.locale[lang] %}
  {% if lang == 'fr' %}
    {% assign nav_prefix = '/fr' %}
  {% else %}
    {% assign nav_prefix = '' %}
  {% endif %}

  <!-- Nav Bar -->
  <nav id="navbar" class="navbar navbar-light navbar-expand-sm {% if site.navbar_fixed %}fixed-top{% else %}sticky-top{% endif %}" role="navigation">
    <div class="container">
      {% if page.permalink != '/' and page.permalink != '/fr/' %}
        <a class="navbar-brand title" href="{{ nav_prefix | append: '/' | relative_url }}">
          {% if page.permalink == '/group/' or page.permalink == '/fr/group/' %}
            <span class="navbar-brand-bold">{{- site.group_name | split: ' ' | first -}}</span>
            {% if lang == 'fr' %}Groupe{% else %}Group{% endif %}
          {% elsif site.title == 'blank' %}
            {% if site.first_name %}
              {{- site.first_name -}}
            {% endif %}
            {% if site.middle_name %}
              {{- site.middle_name -}}
            {% endif %}
            {% if site.last_name %}
              <span class="navbar-brand-bold">{{- site.last_name -}}</span>
            {% endif %}
          {% else %}
            {{- site.title -}}
          {% endif %}
        </a>
      {% elsif site.enable_navbar_social %}
        <!-- Social Icons -->
        <div class="navbar-brand social">{% include social.liquid %}</div>
      {% endif %}
      <!-- Navbar Toggle -->
      <button
        class="navbar-toggler collapsed ml-auto"
        type="button"
        data-toggle="collapse"
        data-target="#navbarNav"
        aria-controls="navbarNav"
        aria-expanded="false"
        aria-label="{{ t.nav.toggle_nav }}"
      >
        <span class="sr-only">{{ t.nav.toggle_nav }}</span>
        <span class="icon-bar top-bar"></span>
        <span class="icon-bar middle-bar"></span>
        <span class="icon-bar bottom-bar"></span>
      </button>

      <div class="collapse navbar-collapse text-right" id="navbarNav">
        <ul class="navbar-nav ml-auto flex-nowrap">
          {% for pg in site.pages %}
            {% if pg.permalink == '/' %} {% assign about_title = t.nav.about %} {% endif %}
          {% endfor %}

          <!-- About -->
          {% assign about_permalink = nav_prefix | append: '/' %}
          <li class="nav-item {% if page.permalink == '/' or page.permalink == '/fr/' %}active{% endif %}">
            <a class="nav-link" href="{{ about_permalink | relative_url }}">
              {{- about_title }}
              {% if page.permalink == '/' or page.permalink == '/fr/' %}
                <span class="sr-only">{{ t.nav.current }}</span>
              {% endif %}
            </a>
          </li>

          <!-- Other pages -->
          {% assign sorted_pages = site.pages | sort: 'nav_order' %}
          {% for p in sorted_pages %}
            {% if p.nav and p.autogen == null %}
              {% comment %} Compute the translated title from locale data {% endcomment %}
              {% assign nav_title = t.nav[p.title] | default: p.title %}
              {% comment %} Compute the lang-aware URL {% endcomment %}
              {% assign nav_url = nav_prefix | append: p.url %}

              {% if p.dropdown %}
                {% assign has_active_child = false %}
                {% for child in p.children %}
                  {% if page.title == child.title %}
                    {% assign has_active_child = true %}
                  {% endif %}
                {% endfor %}
                <li class="nav-item dropdown {% if page.title == p.title or has_active_child %}active{% endif %}">
                  <a
                    class="nav-link dropdown-toggle"
                    href="#"
                    id="navbarDropdown"
                    role="button"
                    data-toggle="dropdown"
                    aria-haspopup="true"
                    aria-expanded="false"
                  >
                    {{- nav_title }}
                    {% if page.title == p.title or has_active_child %}
                      <span class="sr-only">{{ t.nav.current }}</span>
                    {% endif %}
                  </a>
                  <div class="dropdown-menu dropdown-menu-right" aria-labelledby="navbarDropdown">
                    {% for child in p.children %}
                      {% if child.title == 'divider' %}
                        <div class="dropdown-divider"></div>
                      {% else %}
                        <a
                          class="dropdown-item {% if page.title == child.title %}active{% endif %}"
                          href="{% if child.permalink contains '://' %}{{ child.permalink }}{% else %}{{ nav_prefix | append: child.permalink | relative_url }}{% endif %}"
                        >
                          {{- child.title -}}
                        </a>
                      {% endif %}
                    {% endfor %}
                  </div>
                </li>
              {% else %}
                {% assign parent_link = p.permalink | remove: 'index.html' %}
                {% assign current_page_url = page.url | replace: '/fr/', '/' %}
                <li class="nav-item {% if current_page_url contains parent_link %}active{% endif %}">
                  {%- if p.permalink contains '://' -%}
                    {%- assign url = p.permalink -%}
                  {%- elsif p.permalink contains '/blog/' -%}
                    {%- assign url = '/blog/' -%}
                  {%- else -%}
                    {%- assign url = nav_url -%}
                  {%- endif %}
                  <a class="nav-link" href="{{ url | relative_url }}">
                    {{- nav_title }}
                    {% if current_page_url contains p.url %}
                      <span class="sr-only">{{ t.nav.current }}</span>
                    {% endif %}
                  </a>
                </li>
              {% endif %}
            {% endif %}
          {% endfor %}
          {% if site.search_enabled %}
            <!-- Search -->
            <li class="nav-item">
              <button id="search-toggle" title="{{ t.nav.search }}" onclick="openSearchModal()">
                <span class="nav-link">ctrl k <i class="ti ti-search"></i></span>
              </button>
            </li>
          {% endif %}
          {% if site.enable_darkmode %}
            <!-- Toggle theme mode -->
            <li class="toggle-container">
              <button id="light-toggle" title="{{ t.nav.change_theme }}">
                <i class="ti ti-sun-moon" id="light-toggle-system"></i>
                <i class="ti ti-moon-filled" id="light-toggle-dark"></i>
                <i class="ti ti-sun-filled" id="light-toggle-light"></i>
              </button>
            </li>
          {% endif %}
          <!-- Language Toggle -->
          <li class="nav-item">
            {% if lang == 'en' %}
              <a class="nav-link lang-toggle" href="{{ page.lang_pair | default: '/fr/' | relative_url }}">FR</a>
            {% else %}
              <a class="nav-link lang-toggle" href="{{ page.lang_pair | default: '/' | relative_url }}">EN</a>
            {% endif %}
          </li>
        </ul>
      </div>
    </div>
  </nav>
  {% if site.enable_progressbar %}
    <!-- Scrolling Progress Bar -->
    <progress id="progress" value="0">
      <div class="progress-container">
        <span class="progress-bar"></span>
      </div>
    </progress>
  {% endif %}
</header>

{% assign lang = page.lang | default: 'en' %}
{% assign t = site.data.locale[lang] %}
<div class="post">
  <article>
    {% if include.profiles %}
      {% assign position = include.profiles.name %}
      {% if include.is_first %}
        {% assign title_class = '' %}
      {% else %}
        {% assign title_class = 'position' %}
      {% endif %}
      {% comment %} Translate category name {% endcomment %}
      {% assign display_position = t.categories[position] | default: position %}
      <h2 class="{{ title_class }}" id="{{ position | downcase | replace: ' ', '-' }}">{{ display_position }}</h2>
      {% if position != 'Alumni' %}
        <div class="{{ position |  downcase |  replace: ' ', '-' }}-container">
          {% for profile in include.profiles.items %}
            <div class="{{ position |  downcase |  replace: ' ', '-' }}-item">
              <hr>
              <div class="profile float-{% if profile.align == 'left' %}left{% else %}right{% endif %}">
                {% if profile.image %}
                  {% assign profile_image_path = profile.image | prepend: 'assets/img/profiles/' %}
                {% else %}
                  {% assign profile_image_path = 'assets/img/placeholder.jpg' %}
                {% endif %}
                {% if profile.image_circular %}
                  {% assign profile_image_class = 'profile-img img-fluid z-depth-1 rounded-circle' %}
                {% else %}
                  {% assign profile_image_class = 'profile-img img-fluid z-depth-1 rounded' %}
                {% endif %}
                {% capture sizes %}(min-width: {{ site.max_width }}) {{ site.max_width | minus: 30 | times: 0.3}}px, (min-width: 576px) 30vw, 95vw{% endcapture %}
                {% include figure.liquid loading="eager" path=profile_image_path class=profile_image_class sizes=sizes alt=profile.name %}
                {% if profile.more_info %}
                  <div class="more-info">{{ profile.more_info }}</div>
                {% endif %}
              </div>

              <div class="clearfix">
                <h4 id="{{ profile.name | slugify }}">
                  {{ profile.name -}}
                  {%- if profile.website -%}
                    <span style="display: inline-block; width: 4px;"></span>
                    <a href="{{ profile.website }}"><i class="fa-xs fa-solid fa-earth-americas"></i></a>
                  {%- endif %}
                  {%- if profile['google-scholar'] -%}
                    <span style="display: inline-block; width: 4px;"></span>
                    <a href="https://scholar.google.com/citations?user={{ profile.google-scholar }}&view_op=list_works&sortby=pubdate"
                      ><i class="fa-xs fa-brands fa-google-scholar"></i
                    ></a>
                  {%- endif %}
                </h4>
                {% if profile['co-supervisor'] %}
                  {% assign co-supervisors = profile['co-supervisor'] | split: ' & ' %}
                  <h6>
                    <i
                      >({{ t.profiles.co_supervised_by }}
                      {% for cs in co-supervisors %}
                        {%- if forloop.first -%}
                          <a href="{{ site.data.collaborators[cs].url }}">{{ cs }}</a>
                        {%- elsif forloop.last == false -%}
                          , <a href="{{ site.data.collaborators[cs].url }}">{{ cs }}</a>
                        {%- else -%}
                          {% if forloop.index > 2 %},{% endif %}
                          {{ t.profiles.and }}
                          <a href="{{ site.data.collaborators[cs].url }}">{{ cs }}</a>
                        {%- endif -%}
                      {%- endfor -%}
                      )</i
                    >
                  </h6>
                {% elsif group.name == 'Visitors' %}
                  {%- capture supervisor -%}
                    {%- assign supervisors = profile.supervisor | split: " & " -%}
                    {%- for s in supervisors -%}
                      {%- if forloop.first -%}
                        <a href="{{ site.data.collaborators[s].url }}">{{- s -}}</a>
                      {%- elsif forloop.last == false -%}
                        , <a href="{{ site.data.collaborators[s].url }}">{{- s -}}</a>
                      {%- else -%}
                        {% if forloop.index > 2 %},{% endif %} {{ t.profiles.and }} <a href="{{ site.data.collaborators[s].url }}">{{- s -}}</a>
                      {%- endif -%}
                    {%- endfor -%}
                  {%- endcapture -%}
                  {%- capture institute -%}<a href="{{ profile.institute.url }}">{{- profile.institute.name -}}</a>{%- endcapture -%}
                  <h6>
                    <i
                      >({{ t.profiles.supervised_by }}
                      {{ supervisor }}
                      {{ t.profiles.at }}
                      {{ institute }})</i
                    >
                  </h6>
                {% endif %}
                {% if profile.content %}
                  {% if lang == 'fr' and profile.content_fr %}
                    {{ profile.content_fr | markdownify }}
                  {% else %}
                    {{ profile.content | markdownify }}
                  {% endif %}
                {% endif %}
              </div>
            </div>
          {% endfor %}
        </div>
      {% else %}
        <hr>
        {% assign alumni = include.profiles.items | group_by: 'title' %}
        {% for subgroup in alumni %}
          <ul class="profile-list">
            {% assign profiles = subgroup.items | sort_by: 'end' | reverse %}
            {% for profile in subgroup.items %}
              <li class="profile-list-item">
                {% capture time %}{% if profile.end %}, {% if profile.start %}{{ profile.start }}–{% endif %}{{ profile.end }}{% endif %}{% endcapture %}
                {% capture co-supervisor %}{% if profile.co-supervisor %}, {{ t.profiles.co_supervised_by }} <a href="{{ site.data.collaborators[profile.co-supervisor].url }}">{{ profile.co-supervisor }}</a>{% endif %}{% endcapture %}
                {%- capture visiting -%}
                  {%- if profile.title contains "Visiting" -%}
                    {%- assign supervisors = profile.supervisor | split: " & " -%}
                    {%- if lang == 'fr' -%}
                      {{ " " }}{%- if supervisors.size > 1 -%}{{ t.profiles.from_plural }} {{ t.profiles.labs }}{%- else -%}{{ t.profiles.from }} {{ t.profiles.lab }}{%- endif -%}{{ " " }}{{ t.profiles.of }}{{ " " }}
                      {%- for s in supervisors -%}
                        {%- if forloop.first -%}<a href="{{ site.data.collaborators[s].url }}">{{- s -}}</a>
                        {%- elsif forloop.last == false -%}, <a href="{{ site.data.collaborators[s].url }}">{{- s -}}</a>
                        {%- else -%}{% if forloop.index > 2 %},{% endif %} {{ t.profiles.and }} <a href="{{ site.data.collaborators[s].url }}">{{- s -}}</a>
                        {%- endif -%}
                      {%- endfor -%}
                      {{ " " }}{{ t.profiles.at }} <a href="{{ profile.institute.url }}">{{- profile.institute.name -}}</a>
                    {%- else -%}
                      {{ " " }}{{ t.profiles.from }}{{ " " }}
                      {%- for s in supervisors -%}
                        {%- if forloop.first -%}<a href="{{ site.data.collaborators[s].url }}">{{- s -}}</a>
                        {%- elsif forloop.last == false -%}, <a href="{{ site.data.collaborators[s].url }}">{{- s -}}</a>
                        {%- else -%}{% if forloop.index > 2 %},{% endif %} {{ t.profiles.and }} <a href="{{ site.data.collaborators[s].url }}">{{- s -}}</a>
                        {%- endif -%}
                        &rsquo;{%- assign s_last_char = s | slice: -1 -%}{%- if s_last_char != 's' -%}s{%- endif -%}
                      {%- endfor -%}
                      {{ " " }}{%- if supervisors.size > 1 -%}{{ t.profiles.labs }}{%- else -%}{{ t.profiles.lab }}{%- endif %} {{ t.profiles.at }} <a href="{{ profile.institute.url }}">{{- profile.institute.name -}}</a>
                    {%- endif -%}
                  {%- endif -%}
                {%- endcapture -%}
                {%- capture next -%}{% if profile.next %}{% if lang == 'fr' and profile.next_fr %} → {{ profile.next_fr }}{% else %} → {{ profile.next }}{% endif %}{%- endif -%}{%- endcapture -%}
                {%- assign translated_title = t.alumni_titles[profile.title] | default: profile.title -%}
                {{ profile.name }} ({{ translated_title -}}
                {{- visiting -}}
                {{- time -}}
                {{- co-supervisor }}){{ next }}
              </li>
            {% endfor %}
          </ul>
        {% endfor %}
      {% endif %}
    {% endif %}
  </article>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const container = document.querySelector('.{{ position |  downcase |  replace: ' ', '-' }}-container');
    var items = Array.from(container.children);
    for (let i = items.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [items[i], items[j]] = [items[j], items[i]];
    };
    items.forEach(item => container.appendChild(item));
  });
</script>
